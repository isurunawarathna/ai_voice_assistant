# ---------------------------------------------------------------------------
# Copy to .env and adjust. Nested settings use a double underscore.
# ---------------------------------------------------------------------------
ENVIRONMENT=local
CORS_ORIGINS=http://localhost:4200

LOGGING__LEVEL=INFO
LOGGING__JSON_FORMAT=true

# Audio limits applied to every inbound frame
AUDIO__MAX_BYTES=10485760
AUDIO__MAX_SECONDS=60
AUDIO__MIN_SECONDS=0.2
AUDIO__ALLOW_COMPRESSED_INPUT=true

# Speech to text (faster-whisper)
STT__MODEL_SIZE=small
STT__DEVICE=cpu
STT__COMPUTE_TYPE=int8
STT__CPU_THREADS=4
STT__MAX_CONCURRENCY=1
STT__VAD_FILTER=true

# Sessions: memory (single worker) or redis (scaled out)
SESSION__BACKEND=memory
SESSION__TTL_SECONDS=1800
SESSION__MAX_ACTIVE_SESSIONS=100
SESSION__MAX_HISTORY_TURNS=12
# SESSION__REDIS_URL=redis://localhost:6379/0

# Conversation policy
CONVERSATION__LANGUAGE_MAX_RETRIES=3
CONVERSATION__IDLE_TIMEOUT_SECONDS=180
# Longest silence between frames while the caller is choosing a language...
CONVERSATION__LANGUAGE_SELECTION_TIMEOUT_SECONDS=120
# ...and a hard ceiling for the whole selection phase.
CONVERSATION__LANGUAGE_SELECTION_DEADLINE_SECONDS=300
# Consecutive unusable inputs (bad audio, protocol errors, silence) before hang-up.
CONVERSATION__MAX_INVALID_INPUTS=8
# Each "reset" replays a ~1.4 MB prompt, so it is capped per call.
CONVERSATION__MAX_RESETS=10
CONVERSATION__AGENT_TIMEOUT_SECONDS=30

# WebSocket admission control. Unset ENFORCE_ORIGIN = enforced everywhere but ENVIRONMENT=local.
# Browsers must send an Origin listed here (default: CORS_ORIGINS); scripts without
# an Origin header are not browsers and are allowed.
# SECURITY__ENFORCE_ORIGIN=true
# SECURITY__ALLOWED_ORIGINS=https://campus.example,https://www.campus.example
SECURITY__MAX_CONNECTIONS_PER_IP=5
SECURITY__MAX_CONNECTS_PER_MINUTE_PER_IP=30
# Only behind a proxy you control: trusts the first X-Forwarded-For entry.
SECURITY__TRUST_FORWARDED_FOR=false

# Prometheus text at GET /metrics. Keep it on the internal network.
METRICS_ENABLED=true

# Hybrid RAG seam: switch to hybrid_rag and point at your factory
AGENT__BACKEND=echo
# AGENT__BACKEND=hybrid_rag
# AGENT__IMPORT_PATH=my_rag.pipeline:build_agent
AGENT__TOP_K=5

# Text to speech (none until an engine is registered in app/container.py)
TTS__BACKEND=none
